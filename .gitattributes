# 统一换行与编码，避免 Windows / Linux 混编
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.spec text eol=lf
*.txt   text eol=lf

# 二进制，禁止任何换行转换
*.exe  binary
*.png  binary
*.jpg  binary
*.ico  binary

# 视作文本但不做行尾转换
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
